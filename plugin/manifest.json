{
  "manifest_version": 2,
  "name": "Zotero Annotable",
  "version": "0.6.0",
  "description": "Browse all your annotations grouped by color meaning, tag or paper.",
  "author": "bapungiri",
  "homepage_url": "https://github.com/bapungiri/zotero-annotable",
  "icons": {
    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-annotable@bapungiri",
      "update_url": "https://raw.githubusercontent.com/bapungiri/zotero-annotable/main/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.*"
    }
  }
}
