{
  "manifest_version": 2,
  "name": "LitMatrix",
  "version": "1.0.0",
  "description": "A literature-review matrix for Zotero: papers as rows, your highlight-color meanings as columns.",
  "author": "bapungiri",
  "homepage_url": "https://github.com/bapungiri/litmatrix",
  "icons": {
    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "litmatrix@bapungiri",
      "update_url": "https://raw.githubusercontent.com/bapungiri/litmatrix/main/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "9.*"
    }
  }
}
